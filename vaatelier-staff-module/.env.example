# Copy this file to .env and fill it in - see README "Configure your .env".

# --- Database --------------------------------------------------------------
# Local dev default is fine as-is (creates dev.db in the project folder).
# In production (Railway/Render), point this at your persistent Volume,
# e.g. file:/data/production.db
DATABASE_URL=file:./dev.db

# --- Auth --------------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# --- PayMongo (GCash / Maya / Card) -----------------------------------------
# From https://dashboard.paymongo.com/developers - use sk_test_.../pk_test_...
# while developing.
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
# Created when you set up the webhook (see README "Testing real payments locally").
PAYMONGO_WEBHOOK_SECRET=

# --- Pricing (in centavos - 100 = PHP 1.00) ---------------------------------
TRAINING_PRICE_CENTAVOS=49900
COACHING_PRICE_CENTAVOS=30000

# --- Coach / brand -----------------------------------------------------------
COACH_NAME=Reymar Gapud
COACH_TITLE=VA Coach & Trainer

# --- Manual GCash fallback payments (no PayMongo/business registration required) ---
# Shown on the "Pay via GCash (Manual)" screen. See README "Manual GCash payments".
NEXT_PUBLIC_GCASH_NAME=
NEXT_PUBLIC_GCASH_NUMBER=

# --- Site URL ----------------------------------------------------------------
# Used to build absolute PayMongo redirect URLs. Your ngrok URL in local dev,
# your real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email notifications (all optional - leave blank and the app still works,
# you just won't get emailed; see README "Live training session booking +
# notifications" and "Enrolled students, welcome emails & welcome banners") ---
COACH_NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Defaults to SMTP_USER if left blank.
SMTP_FROM=

# --- Seed / admin account -----------------------------------------------------
# Creates a pre-paid admin account the first time you seed, so you can
# preview the full paid experience without paying yourself.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
